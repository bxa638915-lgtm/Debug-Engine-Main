package funkin.game;

/** Maps Funkin character-data JSON and legacy Psych-style JSON to Character's XML schema. */
class CharacterJSONAdapter {
	public static function getSpritePath(data:Dynamic, characterName:String):String {
		if (data != null && data.assetPath != null) {
			var path = Std.string(data.assetPath);
			// Character's XML loader already prefixes this path with `characters/`.
			if (StringTools.startsWith(path, "characters/")) path = path.substr("characters/".length);
			return path;
		}
		if (data != null && data.image != null) return Std.string(data.image);
		if (data != null && data.sprite != null) return Std.string(data.sprite);
		return 'characters/$characterName';
	}

	/** Funkin's `offsets` is the character origin; `position` and x/y are legacy aliases. */
	public static function getGlobalOffset(data:Dynamic, axis:Int):Float {
		if (data == null || axis < 0 || axis > 1) return 0;

		var value = getArrayValue(data.offsets, axis);
		if (value == null) value = getArrayValue(data.position, axis);
		if (value == null) value = axis == 0 ? data.x : data.y;
		return value == null ? 0 : cast value;
	}

	public static function getAnimationName(animation:Dynamic):String {
		if (animation == null) return "idle";
		if (animation.anim != null) return Std.string(animation.anim);
		if (animation.name != null) return Std.string(animation.name);
		return "idle";
	}

	public static function getAnimationPrefix(animation:Dynamic, animationName:String):String {
		if (animation == null) return animationName;
		if (animation.prefix != null) return Std.string(animation.prefix);
		// Legacy JSON uses `anim` for the animation name and `name` for its prefix.
		if (animation.anim != null && animation.name != null) return Std.string(animation.name);
		return animationName;
	}

	public static function getAnimationFrameRate(animation:Dynamic):Float {
		if (animation == null) return 24;
		if (animation.frameRate != null) return cast animation.frameRate;
		if (animation.fps != null) return cast animation.fps;
		return 24;
	}

	public static function isAnimationLooped(animation:Dynamic):Bool {
		if (animation == null) return false;
		if (animation.looped != null) return animation.looped == true;
		return animation.loop == true;
	}

	public static function getAnimationIndices(animation:Dynamic):Array<Dynamic> {
		if (animation == null) return null;
		var frameIndices = animation.frameIndices;
		if (frameIndices != null && Std.isOfType(frameIndices, Array) && frameIndices.length > 0) return cast frameIndices;
		var legacyIndices = animation.indices;
		if (legacyIndices != null && Std.isOfType(legacyIndices, Array) && legacyIndices.length > 0) return cast legacyIndices;
		return null;
	}

	/** Map Funkin texture-atlas animation types to DBE's frame-label flag. */
	public static function getAnimationLabelMode(animation:Dynamic):Null<Bool> {
		if (animation == null) return null;
		if (animation.animType != null) return Std.string(animation.animType).toLowerCase() == "framelabel";
		if (animation.label != null) return animation.label == true || animation.label == "true";
		if (animation.prefix != null) return true;
		return null;
	}

	private static function getArrayValue(value:Dynamic, index:Int):Dynamic {
		if (value == null || !Std.isOfType(value, Array) || value.length <= index) return null;
		return value[index];
	}
}
