<?xml version="1.0" encoding="utf-8"?>
<!--
    FNF UI Studio — Dark Theme
    Inspired by Blender's dark editor and modern IDE color palettes.
    Target: HaxeUI Core (OpenFL backend)
-->
<style>
    /* ============================================================
       ROOT / GLOBAL
    ============================================================ -->
    .haxeui-root {
        background-color: #1A1B1E;
        color: #DCDDDE;
        font-name: "Roboto";
        font-size: 13px;
    }

    /* ============================================================
       WINDOW & PANELS
    ============================================================ -->
    Panel, VBox, HBox {
        background-color: #232428;
        border-color: #111214;
        border-size: 1px;
    }

    .panel-header {
        background-color: #2C2D31;
        color: #FFFFFF;
        font-size: 12px;
        font-bold: true;
        padding: 4px 8px;
        border-bottom-size: 1px;
        border-bottom-color: #111214;
    }

    /* ============================================================
       MENU BAR
    ============================================================ -->
    MenuBar {
        background-color: #18191C;
        border-bottom-size: 1px;
        border-bottom-color: #0D0E10;
    }

    MenuBar > MenuItem {
        color: #AAABAC;
        padding: 4px 10px;
        background-color: transparent;
        border-radius: 3px;
    }

    MenuBar > MenuItem:hover {
        background-color: #3D3F44;
        color: #FFFFFF;
    }

    MenuBar > MenuItem.open {
        background-color: #2F3136;
        color: #FFFFFF;
    }

    Menu {
        background-color: #2F3136;
        border-color: #111214;
        border-size: 1px;
        border-radius: 4px;
        padding: 4px 0px;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.6);
    }

    Menu > MenuItem {
        color: #DCDDDE;
        padding: 5px 20px 5px 12px;
        background-color: transparent;
    }

    Menu > MenuItem:hover {
        background-color: #5865F2;
        color: #FFFFFF;
    }

    Menu > MenuItem.separator {
        background-color: #3D3F44;
        height: 1px;
        margin: 3px 8px;
    }

    Menu > MenuItem .shortcut {
        color: #72767D;
        font-size: 11px;
    }

    /* ============================================================
       TOOLBAR
    ============================================================ -->
    .toolbar {
        background-color: #2F3136;
        border-bottom-size: 1px;
        border-bottom-color: #111214;
        padding: 3px 6px;
    }

    .toolbar > Button {
        background-color: transparent;
        border-color: transparent;
        border-size: 1px;
        color: #B9BBBE;
        padding: 4px 6px;
        border-radius: 4px;
    }

    .toolbar > Button:hover {
        background-color: #40444B;
        color: #FFFFFF;
        border-color: #5865F2;
    }

    .toolbar > Button.active {
        background-color: #5865F2;
        color: #FFFFFF;
    }

    .toolbar-separator {
        background-color: #3D3F44;
        width: 1px;
        margin: 2px 6px;
    }

    /* ============================================================
       BUTTONS
    ============================================================ -->
    Button {
        background-color: #4F545C;
        color: #FFFFFF;
        border-color: #3D3F44;
        border-size: 1px;
        border-radius: 4px;
        padding: 5px 12px;
        font-size: 13px;
    }

    Button:hover {
        background-color: #5D6269;
        border-color: #5865F2;
    }

    Button:active {
        background-color: #3D4047;
        scale-x: 0.98;
        scale-y: 0.98;
    }

    Button:disabled {
        background-color: #2F3136;
        color: #4F545C;
        border-color: #36393F;
    }

    Button.primary {
        background-color: #5865F2;
        border-color: #4752C4;
    }

    Button.primary:hover {
        background-color: #6470F3;
    }

    Button.primary:active {
        background-color: #4752C4;
    }

    Button.danger {
        background-color: #ED4245;
        border-color: #C03537;
    }

    Button.danger:hover {
        background-color: #F04648;
    }

    /* ============================================================
       TEXT INPUTS
    ============================================================ -->
    TextField, TextArea, NumberStepper {
        background-color: #40444B;
        color: #DCDDDE;
        border-color: #202225;
        border-size: 1px;
        border-radius: 4px;
        padding: 4px 8px;
        font-size: 13px;
    }

    TextField:focus, TextArea:focus {
        border-color: #5865F2;
        background-color: #454950;
    }

    TextField:disabled {
        background-color: #36393F;
        color: #72767D;
    }

    /* ============================================================
       DROPDOWNS / COMBO BOX
    ============================================================ -->
    DropDown, ComboBox {
        background-color: #40444B;
        color: #DCDDDE;
        border-color: #202225;
        border-size: 1px;
        border-radius: 4px;
        padding: 4px 8px;
    }

    DropDown:hover, ComboBox:hover {
        border-color: #5865F2;
        background-color: #454950;
    }

    DropDown .popup, ComboBox .popup {
        background-color: #2F3136;
        border-color: #111214;
        border-size: 1px;
        border-radius: 4px;
    }

    DropDown .popup > ListViewItem:hover {
        background-color: #5865F2;
        color: #FFFFFF;
    }

    DropDown .popup > ListViewItem.selected {
        background-color: #4752C4;
        color: #FFFFFF;
    }

    /* ============================================================
       CHECKBOXES & RADIO BUTTONS
    ============================================================ -->
    CheckBox {
        color: #DCDDDE;
        font-size: 13px;
    }

    CheckBox .icon {
        background-color: #40444B;
        border-color: #72767D;
        border-size: 2px;
        border-radius: 3px;
        width: 16px;
        height: 16px;
    }

    CheckBox:selected .icon {
        background-color: #5865F2;
        border-color: #4752C4;
    }

    RadioButton .icon {
        background-color: #40444B;
        border-color: #72767D;
        border-size: 2px;
        border-radius: 8px;
        width: 16px;
        height: 16px;
    }

    RadioButton:selected .icon {
        background-color: #5865F2;
        border-color: #4752C4;
    }

    /* ============================================================
       SLIDERS
    ============================================================ -->
    Slider .thumb {
        background-color: #FFFFFF;
        border-radius: 8px;
        width: 14px;
        height: 14px;
    }

    Slider .track {
        background-color: #40444B;
        border-radius: 4px;
        height: 4px;
    }

    Slider .track-fill {
        background-color: #5865F2;
        border-radius: 4px;
    }

    /* ============================================================
       SCROLLBARS
    ============================================================ -->
    ScrollBar .thumb {
        background-color: #4F545C;
        border-radius: 3px;
        min-width: 6px;
        min-height: 6px;
    }

    ScrollBar .thumb:hover {
        background-color: #72767D;
    }

    ScrollBar .track {
        background-color: transparent;
    }

    /* ============================================================
       TREE VIEW (Hierarchy Panel)
    ============================================================ -->
    TreeView {
        background-color: #1E2022;
        color: #DCDDDE;
    }

    TreeView .item {
        padding: 3px 6px;
        border-radius: 3px;
    }

    TreeView .item:hover {
        background-color: #36393F;
    }

    TreeView .item.selected {
        background-color: #5865F2;
        color: #FFFFFF;
    }

    TreeView .expander {
        color: #72767D;
        font-size: 10px;
    }

    /* ============================================================
       INSPECTOR / PROPERTY PANEL
    ============================================================ -->
    .inspector-section-header {
        background-color: #2C2D31;
        color: #8E9297;
        font-size: 11px;
        font-bold: true;
        padding: 3px 8px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .inspector-row {
        padding: 3px 8px;
        background-color: transparent;
    }

    .inspector-row:nth-child(even) {
        background-color: rgba(0,0,0,0.08);
    }

    .inspector-label {
        color: #8E9297;
        font-size: 12px;
        width: 90px;
    }

    /* ============================================================
       TABS
    ============================================================ -->
    TabView .tab-bar {
        background-color: #2F3136;
        border-bottom-size: 1px;
        border-bottom-color: #111214;
    }

    TabView .tab-button {
        color: #8E9297;
        padding: 6px 14px;
        border-bottom-size: 2px;
        border-bottom-color: transparent;
        background-color: transparent;
    }

    TabView .tab-button:hover {
        color: #DCDDDE;
    }

    TabView .tab-button.selected {
        color: #FFFFFF;
        border-bottom-color: #5865F2;
    }

    TabView .tab-content {
        background-color: #36393F;
    }

    /* ============================================================
       NODE EDITOR (embedded — colors enforced in NodeRenderer too)
    ============================================================ -->
    .node-editor-container {
        background-color: #1A1B1E;
        border-top-size: 1px;
        border-top-color: #111214;
    }

    .node-editor-toolbar {
        background-color: #232428;
        padding: 4px 8px;
        border-bottom-size: 1px;
        border-bottom-color: #111214;
    }

    .node-editor-status {
        background-color: #1A1B1E;
        color: #72767D;
        font-size: 11px;
        padding: 2px 8px;
        border-top-size: 1px;
        border-top-color: #111214;
    }

    /* ============================================================
       DIALOG / MODAL WINDOWS
    ============================================================ -->
    Dialog {
        background-color: #36393F;
        border-color: #202225;
        border-size: 1px;
        border-radius: 8px;
        box-shadow: 0px 8px 32px rgba(0,0,0,0.8);
    }

    Dialog .dialog-title {
        background-color: #2F3136;
        color: #FFFFFF;
        font-bold: true;
        font-size: 14px;
        padding: 12px 16px;
        border-bottom-size: 1px;
        border-bottom-color: #202225;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
    }

    Dialog .dialog-content {
        padding: 16px;
    }

    Dialog .dialog-footer {
        padding: 12px 16px;
        border-top-size: 1px;
        border-top-color: #202225;
        background-color: #2F3136;
    }

    /* ============================================================
       STATUS BAR
    ============================================================ -->
    .status-bar {
        background-color: #5865F2;
        color: #FFFFFF;
        font-size: 12px;
        padding: 2px 8px;
    }

    /* ============================================================
       SPLITTERS
    ============================================================ -->
    SplitView .splitter {
        background-color: #111214;
        width: 3px;
        height: 3px;
    }

    SplitView .splitter:hover {
        background-color: #5865F2;
    }

    /* ============================================================
       TOOLTIPS
    ============================================================ -->
    ToolTip {
        background-color: #18191C;
        color: #DCDDDE;
        border-color: #111214;
        border-size: 1px;
        border-radius: 4px;
        padding: 4px 8px;
        font-size: 12px;
    }

    /* ============================================================
       SELECTION HIGHLIGHT (ViewportPanel)
    ============================================================ -->
    .selection-handle {
        background-color: #5865F2;
        border-color: #FFFFFF;
        border-size: 1px;
        border-radius: 2px;
        width: 8px;
        height: 8px;
    }

    .selection-border {
        border-color: #5865F2;
        border-size: 1px;
        border-style: dashed;
    }
</style>
